{% else %}
/* #undef CONFIG_ARTI_ENABLED */
{% endif %}
{% if arti.task_trace %}
#define CONFIG_ARTI_TASK_TRACE           1
{% else %}
/* #undef CONFIG_ARTI_TASK_TRACE */
{% endif %}
{% if arti.resource_trace %}
#define CONFIG_ARTI_RESOURCE_TRACE       1
{% else %}
/* #undef CONFIG_ARTI_RESOURCE_TRACE */
{% endif %}
{% if arti.spinlock_trace %}
#define CONFIG_ARTI_SPINLOCK_TRACE       1
{% else %}
/* #undef CONFIG_ARTI_SPINLOCK_TRACE */
{% endif %}
{% if arti.int_trace %}
#define CONFIG_ARTI_INT_TRACE            1
{% else %}
/* #undef CONFIG_ARTI_INT_TRACE */
{% endif %}
{% if arti.cat2isr_trace %}
#define CONFIG_ARTI_CAT2ISR_TRACE        1
{% else %}
/* #undef CONFIG_ARTI_CAT2ISR_TRACE */
{% endif %}
{% if arti.runnable_trace %}
#define CONFIG_ARTI_RUNNABLE_TRACE       1
{% else %}
/* #undef CONFIG_ARTI_RUNNABLE_TRACE */
{% endif %}

/* --------------------------------------------------------------------------
 * OS instance name
 * Must match the SHORT-NAME of the <Os> element in ARXML.
 * TRACE32 uses this to locate matching ARTI_TRACE_* macro names.
 * -------------------------------------------------------------------------- */
#define ARTI_OS_SHORT_NAME   HaloOs

/* --------------------------------------------------------------------------
 * Module version info
 * -------------------------------------------------------------------------- */
#define ARTI_VENDOR_ID         0u
#define ARTI_MODULE_ID         0u
#define ARTI_SW_MAJOR_VERSION  1u
